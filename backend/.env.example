# Secrets belong in the hosting secret manager, never in frontend files.
NODE_ENV=development
PORT=5000
# Production: mandatory restricted-role PostgreSQL URL, no SQLite fallback.
DATABASE_URL=
DATABASE_SSL=on
DATABASE_CA_FILE=
DATABASE_POOL_MAX=2
# Operations tool ONLY: separate privileged URL, never used by the running backend.
# scripts/migrate.js also requires explicit approval flags and a verified backup manifest.
MIGRATION_DATABASE_URL=
MIGRATION_DATABASE_CA_FILE=
SQLITE_FILE=data/conversations.db
# Production: at least 32 random characters, distinct between staging and production.
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_HOURS=8
AUTH_USERS_FILE=
GROQ_API_KEY=
TONE_REWRITE=off
# Exact frontend HTTPS origins, comma-separated; no wildcard in production.
CORS_ORIGINS=
TRUST_PROXY_HOPS=1
# Production must use database. json is development/rollback only.
VECTOR_BACKEND=json
WARM_MODEL_ON_START=no
SUPABASE_URL=
SUPABASE_DOCUMENT_BUCKET=
SUPABASE_STORAGE_KEY=
# Server-only sb_secret_ key uses apikey; legacy service-role JWT also uses Bearer.
# Never put either in frontend configuration. Mount AUTH_USERS_FILE privately on host.
# Proposed bucket settings are in deployment/storage-plan.json; not created automatically.
KNOWLEDGE_MAX_UPLOAD=25mb
# Frontend build only: public HTTPS API URL ending in /api. Never place secrets here.
PUBLIC_API_BASE=

# One revision-checked corpus snapshot; answers and applicant grades are not cached.
KNOWLEDGE_CACHE_MAX_BYTES=33554432
QUERY_PLANNER_ENABLED=true
KNOWLEDGE_WARM_SNAPSHOT_ON_START=yes
DATABASE_CONNECT_TIMEOUT_MS=20000
