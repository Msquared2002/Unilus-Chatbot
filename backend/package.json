{
  "name": "unilus-backend",
  "version": "2.0.0",
  "main": "server.js",
  "description": "UNILUS AI Student Digital Companion backend: timetable search + university knowledge retrieval (RAG).",
  "scripts": {
    "campus:update": "python scripts/updateCampusOsm.py",
    "campus:routing:build": "node scripts/buildCampusRoutingGraph.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "ingest": "node scripts/ingestDocuments.js",
    "ingest:website": "node scripts/ingestWebsite.js",
    "build-index": "node scripts/buildKnowledgeIndex.js",
    "knowledge:rebuild": "npm run ingest && npm run ingest:website && npm run build-index",
    "test": "node --test",
    "retrieval:inspect": "node scripts/inspectRetrieval.js",
    "knowledge:upgrade-metadata": "node scripts/upgradeKnowledgeMetadata.js",
    "retrieval:benchmark": "node scripts/benchmarkRetrieval.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "groq-sdk": "^1.6.0",
    "mammoth": "^1.8.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
